# ============================================================
# 企业级RAG知识库与AI Agent协作平台 - 环境变量配置示例
# ============================================================
#
# 说明：
# 1. 复制此文件为 .env 或 .env.local 进行本地开发配置
# 2. 将 your_xxx 替换为真实的密钥值
# 3. 生产环境请使用安全的密钥管理服务
#

# ==================== 大语言模型配置 ====================
# 智谱AI API密钥（用于调用GLM系列模型） 只需要把这个换成你的密钥放入.env就行了，下面的不用管也行
OPENAI_API_KEY=your_zhipu_api_key
# API基础URL（智谱AI的OpenAI兼容接口地址）
OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4
# 默认使用的模型名称
OPENAI_MODEL_NAME=glm-Z1-flash

# ==================== 向量数据库配置 ====================
# ChromaDB服务器地址
CHROMA_SERVER_HOST=localhost
# ChromaDB服务器端口
CHROMA_SERVER_PORT=8000
# ChromaDB集合名称（用于存储文档向量）
CHROMA_COLLECTION_NAME=documents

# ==================== 搜索API配置 ====================
# SerpAPI密钥（用于网络搜索工具）
SERPAPI_API_KEY=your_serpapi_key

# ==================== 应用配置 ====================
# 应用端口号
PORT=3000
# Node环境（development/production）
NODE_ENV=development
# 最大文件上传大小（字节，默认10MB）
MAX_FILE_SIZE=10485760
